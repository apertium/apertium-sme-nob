<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px3pl"/></l><r>sin<s n="det"/><s n="pos"/><s n="GD"/><s n="ND"/></r></p></e>
 <!-- Genitive after Pron.Pers
      Dá lea mu iežan girji → Her er min egen bok -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/></l><r>egen<s n="det"/><s n="emph"/><s n="GD"/><s n="sg"/><s n="gen"/></r></p><par n="LR_remove_nbr_pers"/></e>
 <!-- Komitative
      Mun jurddašin iežainan → jeg tenkte med _meg selv_ -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="com"/></l><r>seg<b/>selv<s n="prn"/><s n="ref"/><s n="com"/></r></p><par n="__nbr_pers"/></e>
 <!-- Illative
      Mánát guvle alcceseaset speadjalis → Barnene kikte på seg selv i speilet
      lea munnje alccesan → det er til meg selv(?) -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="ill"/></l><r>seg<b/>selv<s n="prn"/><s n="ref"/><s n="ill"/></r></p><par n="__nbr_pers"/></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="ill"/></l><r>selv<s n="det"/><s n="emph"/><s n="ill"/></r></p><par n="LR_remove_nbr_pers"/></e>
 <!-- Locative        (t1x inserts no caseprep here)
      Mis leat alddámet.Loc ain šibihat → Vi har _selv_ fremdeles husdyr -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="loc"/></l><r>selv<s n="det"/><s n="emph"/><s n="loc"/></r></p><par n="LR_remove_nbr_pers"/></e>
