 <!-- ISOLATED-NUMEXP: -->
<e><re>[½¹²³¼¾]</re><p><l><s n="num"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
<e><re>[½¹²³¼¾]</re><p><l><s n="num"/><s n="cmp"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
<e><re>[½¹²³¼¾]</re><p><l><s n="num"/><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
 <!-- ARABIC (incl. NUM-PREFIXES): -->
<e r="LR"><par n="num-arabic"/><re>(,\-| \-| \-\-)?</re><par n="num-delimit"/><par n="num__det_qnt_pl"/></e>
<e>       <par n="num-arabic"/><re>(,\-| \-| \-\-)?</re><par n="num__det_qnt_pl"/></e>
 <!-- for some reason, % gets a Num Nom added before Num by smemorf (bug? TODO) -->
<e r="LR"><par n="num-arabic"/><re> ?%</re><par n="num-delimit"/><par n="num__det_qnt_pl"/></e>
<e>       <par n="num-arabic"/><re> ?%</re><par n="num__det_qnt_pl"/></e>

 <!-- smemorf removes ['-:] (num-delimit) from Collectives: -->
<e>       <par n="num-arabic"/><par n="coll__n"/></e>
 <!-- (we stay on the safe side and don't output "<b/>personer" here, it's perfectly possible to say "der går det 99" with "personer/stykk" implicit) -->

 <!-- The sme lemma doesn't (necessarily?) include the dot, nob does -->
<e r="LR"><par n="num-arabic"/><par n="num-delimit"/><p><l></l><r>.</r></p><par n="ord__adj"/></e>
<e>       <par n="num-arabic"/><re>[.]?</re><p><l></l><r>.</r></p><par n="ord__adj"/></e>

 <!-- ROMAN -->
<e r="LR"><re>[IVXLCDM\-]+</re><par n="num_no-nbr__det_qnt_pl"/><p><l/><r><s n="fixedcase"/></r></p></e>
<e r="LR"><re>[IVXLCDM\-]+</re><p><l></l><r>.</r></p><par n="ord__adj"/><p><l></l><r><s n="fixedcase"/></r></p></e>

 <!-- /numerals -->

