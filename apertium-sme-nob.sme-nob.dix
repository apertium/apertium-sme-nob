 <!-- Reflexive pronoun (ieš), split into each case -->
 <!-- Nominative
      Ieš.Nom don mearridat → Du bestemmer _selv_  -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="sg"/><s n="nom"/></l><r>selv<s n="det"/><s n="emph"/><s n="DD"/><s n="un"/><s n="sp"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="du"/><s n="nom"/></l><r>selv<s n="det"/><s n="emph"/><s n="DD"/><s n="un"/><s n="sp"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="pl"/><s n="nom"/></l><r>selv<s n="det"/><s n="emph"/><s n="DD"/><s n="un"/><s n="sp"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="nom"/></l><r>selv<s n="det"/><s n="emph"/><s n="DD"/><s n="un"/><s n="sp"/></r></p><par n="LR_remove_nbr_pers"/></e>
 <!-- Accusative
      Áhkku geahčai iežas speadjalis → Bestemora så seg selv i speilet -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="acc"/></l><r>seg<b/>selv<s n="prn"/><s n="ref"/><s n="acc"/></r></p><par n="__nbr_pers"/></e>
<!--  eai galgga soardit min iežamet → ikke skal gjøre vondt for oss selv -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="acc"/></l><r>selv<s n="det"/><s n="emph"/><s n="nom"/></r></p><par n="LR_remove_nbr_pers"/></e>
 <!-- Accusative subject/object of V.Actio/Inf
      Elle muitalii iežas vuolgime → Elle fortalte at hun reiste -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="acc"/></l><r>prpers<s n="prn"/><s n="acc"/><s n="GD"/></r></p><par n="__nbr_pers"/></e>
<!-- su iežas → hans egen (not sure why it doesn't get gen here) -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="acc"/></l><r>egen<s n="det"/><s n="emph"/><s n="GD"/><s n="sg"/><s n="gen"/></r></p><par n="LR_remove_nbr_pers"/></e>
 <!-- Reflexive (genitive due to postposition, but marked @→P)
      Váldde biergasiid iežat fárrui → Ta sakene med deg -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px1sg"/></l><r>jeg<s n="prn"/><s n="pers"/><s n="p1"/><s n="mf"/><s n="sg"/><s n="acc"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px2sg"/></l><r>du<s n="prn"/><s n="pers"/><s n="p2"/><s n="mf"/><s n="sg"/><s n="acc"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px3sg"/></l><r>seg<s n="prn"/><s n="ref"/><s n="p3"/><s n="un"/><s n="sp"/><s n="acc"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px1du"/></l><r>vi<s n="prn"/><s n="pers"/><s n="p1"/><s n="mf"/><s n="du"/><s n="acc"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px2du"/></l><r>dere<s n="prn"/><s n="pers"/><s n="p2"/><s n="mf"/><s n="du"/><s n="acc"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px3du"/></l><r>de<s n="prn"/><s n="pers"/><s n="p3"/><s n="mf"/><s n="du"/><s n="acc"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px1pl"/></l><r>vi<s n="prn"/><s n="pers"/><s n="p1"/><s n="mf"/><s n="pl"/><s n="acc"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px2pl"/></l><r>dere<s n="prn"/><s n="pers"/><s n="p2"/><s n="mf"/><s n="pl"/><s n="acc"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px3pl"/></l><r>de<s n="prn"/><s n="pers"/><s n="p3"/><s n="mf"/><s n="pl"/><s n="acc"/></r></p></e>
<!-- Genitive        (Possessor number mapped to lemma)
     Mun ferten čorget iežan lanja → Jeg må rydde mitt rom -->
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px1sg"/></l><r>min<s n="det"/><s n="pos"/><s n="GD"/><s n="ND"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px2sg"/></l><r>din<s n="det"/><s n="pos"/><s n="GD"/><s n="ND"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px3sg"/></l><r>sin<s n="det"/><s n="pos"/><s n="GD"/><s n="ND"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px1du"/></l><r>vår<s n="det"/><s n="pos"/><s n="GD"/><s n="ND"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px2du"/></l><r>deres²<s n="det"/><s n="pos"/><s n="GD"/><s n="ND"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px3du"/></l><r>sin<s n="det"/><s n="pos"/><s n="GD"/><s n="ND"/></r></p></e>
<e><par n="ieš"/><p><l><s n="prn"/><s n="ref"/><s n="gen"/><s n="px1pl"/></l><r>vår<s n="det"/><s n="pos"/><s n="GD"/><s n="ND"/></r></p></e>
