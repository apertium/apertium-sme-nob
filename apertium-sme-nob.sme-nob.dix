    <!-- Transfer -->
    <sdef n="GD"      c="Gender to be determined"/>
    <sdef n="GD_pers" c="Gender to be determined, can only be m or f"/>
    <sdef n="ND"      c="Number to be determined"/>
    <sdef n="PD"      c="Person to be determined"/>
    <sdef n="TD"      c="Temps to be determined"/>
    <sdef n="CD"      c="Case to be determined"/>
    <sdef n="DD"      c="Definiteness to be determined"/>

    <sdef n="fixedcase"      c="Don't allow changes to typographical case (letter-case)"/>

    <sdef n="ep-Ø"    c="no epenthesis"/>
    <sdef n="ep-s"    c="s-epenthesis"/>
    <sdef n="ep-e"    c="e-epenthesis"/>
  </sdefs>

  <pardefs>
    <!-- pardefs: ADPOSITIONS -->


    <pardef n="pron__det-no-gen" c="User of this pardef should add gender/GD
				    Maps singular to singular, plural to plural">
      <e><p><l><s n="attr"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="sg"/><s n="nom"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="sg"/><s n="acc"/></l><r><s n="sg"/><s n="acc"/></r></p></e>
      <e><p><l><s n="sg"/><s n="gen"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="ill"/></l><r><s n="sg"/><s n="ill"/></r></p></e>
      <e><p><l><s n="sg"/><s n="loc"/></l><r><s n="sg"/><s n="loc"/></r></p></e>

      <!-- er dualis => pl OK for desse? -->
      <e r="LR"><p><l><s n="du"/><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e r="LR"><p><l><s n="du"/><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e r="LR"><p><l><s n="du"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e r="LR"><p><l><s n="du"/><s n="ill"/></l><r><s n="pl"/><s n="ill"/></r></p></e>
      <e r="LR"><p><l><s n="du"/><s n="loc"/></l><r><s n="pl"/><s n="loc"/></r></p></e>

      <e><p><l><s n="pl"/><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/></l><r><s n="pl"/><s n="ill"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/></l><r><s n="pl"/><s n="loc"/></r></p></e>

      <e><p><l><s n="ess"/></l>           <r><s n="ND"/><s n="ess"/></r></p></e>

      <e><p><l><s n="pl"/><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/></l><r><s n="pl"/><s n="ill"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/></l><r><s n="pl"/><s n="loc"/></r></p></e>

      <e><p><l><s n="attr"/></l><r><s n="ND"/></r></p></e>
      <e><p><l></l><r><s n="ND"/></r></p></e>
    </pardef>
    <pardef n="pron__det-no-gen-nbr" c="Same as above, but don't specify nob number
					User of this pardef should add gender/GD and number">
      <e><p><l><s n="sg"/><s n="nom"/></l><r><s n="nom"/></r></p></e>
      <e><p><l><s n="sg"/><s n="acc"/></l><r><s n="acc"/></r></p></e>
      <e><p><l><s n="sg"/><s n="gen"/></l><r><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="ill"/></l><r><s n="ill"/></r></p></e>
      <e><p><l><s n="sg"/><s n="loc"/></l><r><s n="loc"/></r></p></e>

      <!-- er dualis => pl OK for desse? -->
      <e r="LR"><p><l><s n="du"/><s n="nom"/></l><r><s n="nom"/></r></p></e>
      <e r="LR"><p><l><s n="du"/><s n="acc"/></l><r><s n="acc"/></r></p></e>
      <e r="LR"><p><l><s n="du"/><s n="gen"/></l><r><s n="gen"/></r></p></e>
      <e r="LR"><p><l><s n="du"/><s n="ill"/></l><r><s n="ill"/></r></p></e>
      <e r="LR"><p><l><s n="du"/><s n="loc"/></l><r><s n="loc"/></r></p></e>

      <e><p><l><s n="pl"/><s n="nom"/></l><r><s n="nom"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/></l><r><s n="acc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/></l><r><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/></l><r><s n="ill"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/></l><r><s n="loc"/></r></p></e>

      <e><p><l><s n="ess"/></l>           <r><s n="ess"/></r></p></e>

      <e><p><l><s n="pl"/><s n="nom"/></l><r><s n="nom"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/></l><r><s n="acc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/></l><r><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/></l><r><s n="ill"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/></l><r><s n="loc"/></r></p></e>

      <e><p><l><s n="attr"/></l><r></r></p></e>
      <e><p><l></l><r></r></p></e>
    </pardef>
    <pardef n="pron__det">
      <e><p><l></l><r><s n="GD"/></r></p><par n="pron__det-no-gen"/></e>
    </pardef>

    <pardef n="ieš" c="jieš is the same as ieš">
      <e r="LR">  <p><l>jieš</l><r></r></p></e>
      <e>         <p><l>ieš</l><r></r></p></e>
    </pardef>

    <!-- pardefs: NUMBER → DET.QNT -->
    <pardef n="__num-case">
      <e><p><l><s n="nom"/></l><r><s n="nom"/></r></p></e>
      <e><p><l><s n="acc"/></l><r><s n="acc"/></r></p></e>
      <e><p><l><s n="gen"/></l><r><s n="gen"/></r></p></e>
      <e><p><l><s n="com"/></l><r><s n="com"/></r></p></e>
      <e><p><l><s n="ess"/></l><r><s n="ess"/></r></p></e>
      <e><p><l><s n="ill"/></l><r><s n="ill"/></r></p></e>
      <e><p><l><s n="loc"/></l><r><s n="loc"/></r></p></e>
      <e><p><l><s n="attr"/></l><r></r></p></e>
      <e><p><l/><r/></p></e>
    </pardef>
    <pardef n="maybe-cmp__guio" c="used after num__det_qnt pardefs">
      <e r="LR">  <p><l><s n="cmp_splitr"/><s n="cmp"/></l>                            <r><s n="guio"/></r></p></e>
      <e r="LR">  <p><l><s n="cmp_sgnom"/><s n="cmp_splitr"/><s n="cmp"/></l>           <r><s n="guio"/></r></p></e>
      <e r="LR">  <p><l><s n="cmp_sggen"/><s n="cmp_splitr"/><s n="cmp"/></l> <r><s n="guio"/></r></p></e>
      <e r="LR">  <p><l><s n="cmp_hyph"/><s n="cmp"/></l>                  <r><s n="guio"/></r></p></e>
      <e r="LR">  <p><l><s n="cmp_hyph"/></l>                  <r><s n="guio"/></r></p></e>
      <e r="LR">  <p><l><s n="cmp"/><s n="guio"/></l>                  <r><s n="guio"/></r></p></e>
      <!-- fallthrough: -->
      <e><p><l></l><r></r></p></e>
    </pardef>
    <pardef n="num__det_qnt_sg">
      <e><p><l><s n="num"/><s n="sg"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p><par n="maybe-cmp__guio"/></e>
      <e><p><l><s n="num"/><s n="pl"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p><par n="maybe-cmp__guio"/></e>
      <e><p><l><s n="num"/></l>           <r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p><par n="maybe-cmp__guio"/></e>
    </pardef>
    <pardef n="num__det_qnt_pl">
      <e><p><l><s n="num"/><s n="sg"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p><par n="maybe-cmp__guio"/></e>
      <e><p><l><s n="num"/><s n="pl"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p><par n="maybe-cmp__guio"/></e>
      <e><p><l><s n="num"/></l>           <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p><par n="maybe-cmp__guio"/></e>
    </pardef>
    <pardef n="num_abbr__det_qnt_pl">
      <e><p><l><s n="num"/><s n="abbr"/><s n="sg"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p><par n="maybe-cmp__guio"/></e>
      <e><p><l><s n="num"/><s n="abbr"/><s n="pl"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p><par n="maybe-cmp__guio"/></e>
      <e><p><l><s n="num"/><s n="abbr"/></l>           <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p><par n="maybe-cmp__guio"/></e>
    </pardef>
    <pardef n="num__det_qnt_sg_GD">
      <e><p><l><s n="num"/><s n="sg"/></l><r><s n="det"/><s n="qnt"/><s n="GD"/><s n="sg"/></r></p><par n="maybe-cmp__guio"/></e>
      <e><p><l><s n="num"/><s n="pl"/></l><r><s n="det"/><s n="qnt"/><s n="GD"/><s n="sg"/></r></p><par n="maybe-cmp__guio"/></e>
      <e><p><l><s n="num"/></l>           <r><s n="det"/><s n="qnt"/><s n="GD"/><s n="sg"/></r></p><par n="maybe-cmp__guio"/></e>
    </pardef>
    <pardef n="num_no-nbr__det_qnt_pl" c="for some reason, roman numerals have no number">
      <e><p><l><s n="num"/></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p><par n="maybe-cmp__guio"/></e>
      <e><p><l><s n="num"/></l>           <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p><par n="maybe-cmp__guio"/></e>
    </pardef>

    <pardef n="num-prefix">
      <!--TODO: the first one should contain `<' and `>' -->
      <e><re>[§\-‒–—―\+\*$€.]</re></e>
      <e><re>[§\-‒–—―\+] </re></e>
      <e><re>§§</re></e>
      <e><re>§§ </re></e>
      <e><re>s.</re></e>
    </pardef>
    <pardef n="num-arabicloop">
      <e>
	<!-- note: that's not two spaces in the first [], but a space and an nbsp -->
	<re>([0-9]+([:'\-–—/  .,]|[.][\-–—]|[\-–—/] | \-\- | [\-–—/]| [\-–—.,\+] ))*</re> <!-- ARABIC then ARABICLOOP -->
	<re>[0-9]+</re> <!-- at least one ARABIC, then finals -->
      </e>
    </pardef>
    <pardef n="num-arabic" c="TODO: smemorf puts : symbols after tags, bug!">
      <e><par n="num-arabicloop"/></e>
      <e><par n="num-prefix"/><par n="num-arabicloop"/></e>
      <!-- TODO: numeral compounds -->
      <e><par n="num-arabicloop"/><re>[abcdef]|f f</re></e>
      <e><par n="num-prefix"/><par n="num-arabicloop"/><re>[abcdef]|f f</re></e>
    </pardef>
    <pardef n="num-delimit" c="Optional number delimiters (can also be empty, so we use two entries)">
      <e><p><l>'</l><r></r></p></e>
      <e><p><l>-</l><r></r></p></e>
      <e><p><l>:</l><r></r></p></e>
    </pardef>
    <pardef n="okta-ovcci__en-ni" c="does _not_ include an empty transition.
				     Used in old numerals, thus 'syv'...">
      <e><p><l>okta</l><r>en</r></p></e>
      <e><p><l>guokte</l><r>to</r></p></e>
      <e><p><l>golbma</l><r>tre</r></p></e>
      <e><p><l>njeallje</l><r>fire</r></p></e>
      <e r="LR"><p><l>njeallja</l><r>fire</r></p></e>
      <e><p><l>vihtta</l><r>fem</r></p></e>
      <e><p><l>guhtta</l><r>seks</r></p></e>
      <e><p><l>čieža</l><r>syv</r></p></e>
      <e r="LR"><p><l>gieža</l><r>syv</r></p></e>
      <e><p><l>gávcci</l><r>åtte</r></p></e>
      <e><p><l>ovcci</l><r>ni</r></p></e>
    </pardef>
    <pardef n="Ø_okta-ovcci" c="includes an empty transition">
      <e><p><l></l><r></r></p></e>
      <e><p><l>okta</l><r>en</r></p></e>
      <e r="LR"><p><l>akta</l><r>en</r></p></e>
      <e><p><l>guokte</l><r>to</r></p></e>
      <e><p><l>golbma</l><r>tre</r></p></e>
      <e><p><l>njeallje</l><r>fire</r></p></e>
      <e r="LR"><p><l>njeallja</l><r>fire</r></p></e>
      <e><p><l>vihtta</l><r>fem</r></p></e>
      <e><p><l>guhtta</l><r>seks</r></p></e>
      <e><p><l>čieža</l><r>syv</r></p></e>
      <e r="LR"><p><l>gieža</l><r>syv</r></p></e>
      <e><p><l>gávcci</l><r>åtte</r></p></e>
      <e><p><l>ovcci</l><r>ni</r></p></e>
    </pardef>
    <pardef n="ovttas-ovccis__en-ni_personer" c="does _not_ include an empty transition">
      <e><p><l>ovttas</l><r>en<b/>person</r></p></e>
      <e><p><l>guovttis</l><r>to<b/>personer</r></p></e>
      <e><p><l>guovttes</l><r>to<b/>personer</r></p></e>
      <e><p><l>guoktá</l><r>to<b/>personer</r></p></e>
      <e><p><l>golmmas</l><r>tre<b/>personer</r></p></e>
      <e><p><l>njealjis</l><r>fire<b/>personer</r></p></e>
      <e><p><l>viđas</l><r>fem<b/>personer</r></p></e>
      <e><p><l>guđas</l><r>seks<b/>personer</r></p></e>
      <e><p><l>čiežas</l><r>sju<b/>personer</r></p></e>
      <e r="LR"><p><l>giežas</l><r>sju<b/>personer</r></p></e>
      <e><p><l>gávccis</l><r>åtte<b/>personer</r></p></e>
      <e><p><l>ovcci</l><r>ni<b/>personer</r></p></e>
    </pardef>
    <pardef n="vuosttas-ovccat__første-niende" c="does _not_ include an empty transition">
      <e r="LR"><p><l>vuosttaš</l><r>første</r></p></e>
      <e><p><l>vuosttas</l><r>første</r></p></e>
      <e r="LR"><p><l>nubbe</l><r>andre</r></p></e>
      <e><p><l>nubbi</l><r>andre</r></p></e>
       <e><p><l>nubbi</l><r>nest</r></p></e>
     <e><p><l>goalmmát</l><r>tredje</r></p></e>
      <e><p><l>njealját</l><r>fjerde</r></p></e>
      <e><p><l>viđát</l><r>femte</r></p></e>
      <e><p><l>viđat</l><r>femte</r></p></e>
      <e><p><l>guđát</l><r>sjette</r></p></e>
      <e><p><l>guđat</l><r>sjette</r></p></e>
      <e><p><l>čihččet</l><r>sjuende</r></p></e>
      <e><p><l>čihččet</l><r>i<b/>seksti</r></p></e>
      <e><p><l>gávccát</l><r>åttende</r></p></e>
      <e><p><l>ovccát</l><r>niende</r></p></e>
    </pardef>
    <pardef n="lohkaiduhat__tusen" c="lotduhát should be equivalent">
      <e><p><l>lohkáiduhát</l><r>tusen</r></p></e>
      <e r="LR"><p><l>lotduhát</l><r>tusen</r></p></e>
    </pardef>
    <pardef n="lohkaiduhahat__tusen" c="lotduhát should be equivalent">
      <e><p><l>lohkáiduháhat</l><r>tusen</r></p></e>
      <e r="LR"><p><l>lotduháhat</l><r>tusen</r></p></e>
    </pardef>
    <pardef n="Ø_cuodi" c="includes an empty transition">
      <e><p><l></l><r></r></p></e>
      <e><p><l>čuođi</l><r>hundre<b/>og<b/></r></p></e>
      <e r="LR"><p><l>čuohti</l><r>hundre<b/>og<b/></r></p></e>
      <e><p><l>oktačuohti</l><r>et<b/>hundre<b/>og<b/></r></p></e>
    </pardef>
    <pardef n="cuodi" c="no empty transition, meant to come after 1-9">
      <e><p><l>čuođi</l><r>hundre<b/>og<b/></r></p></e>
      <e r="LR"><p><l>čuohti</l><r>hundre<b/>og<b/></r></p></e>
    </pardef>
    <pardef n="Ø_duhat" c="includes an empty transition">
      <e><p><l></l><r></r></p></e>
      <e><p><l>duhát</l><r><b/>tusen</r></p></e>
    </pardef>
    <pardef n="Ø_oktacuodi-ovccicuodi" c="includes an empty transition, the rest are oktacuodi, etc.">
      <e><p><l></l><r></r></p><par n="Ø_cuodi"/></e>  <!-- simply "guoktelogi-tjue" etc., or čuođiguoktelogi-hundre og tjue -->
      <e><p><l>okta</l><r>et<b/></r></p><par n="cuodi"/></e>
      <e r="LR"><p><l>akta</l><r>et<b/></r></p><par n="cuodi"/></e>
      <e><p><l>guokte</l><r>to<b/></r></p><par n="cuodi"/></e>
      <e><p><l>golbma</l><r>tre<b/></r></p><par n="cuodi"/></e>
      <e><p><l>njeallje</l><r>fire<b/></r></p><par n="cuodi"/></e>
      <e r="LR"><p><l>njeallja</l><r>fire<b/></r></p><par n="cuodi"/></e>
      <e><p><l>vihtta</l><r>fem<b/></r></p><par n="cuodi"/></e>
      <e><p><l>guhtta</l><r>seks<b/></r></p><par n="cuodi"/></e>
      <e><p><l>čieža</l><r>sju<b/></r></p><par n="cuodi"/></e>
      <e r="LR"><p><l>gieža</l><r>sju<b/></r></p><par n="cuodi"/></e>
      <e><p><l>gávcci</l><r>åtte<b/></r></p><par n="cuodi"/></e>
      <e><p><l>ovcci</l><r>ni<b/></r></p><par n="cuodi"/></e>
    </pardef>
    <pardef n="Ø_okta-ovcci_duhat" c="includes an empty transition, the rest are oktaduhat/okta, etc.">
      <e><p><l></l><r></r></p><par n="Ø_duhat"/></e>
      <e><p><l>okta</l><r>en</r></p><par n="Ø_duhat"/></e>
      <e r="LR"><p><l>akta</l><r>en</r></p><par n="Ø_duhat"/></e>
      <e><p><l>guokte</l><r>to</r></p><par n="Ø_duhat"/></e>
      <e><p><l>golbma</l><r>tre</r></p><par n="Ø_duhat"/></e>
      <e><p><l>njeallje</l><r>fire</r></p><par n="Ø_duhat"/></e>
      <e r="LR"><p><l>njeallja</l><r>fire</r></p><par n="Ø_duhat"/></e>
      <e><p><l>vihtta</l><r>fem</r></p><par n="Ø_duhat"/></e>
      <e><p><l>guhtta</l><r>seks</r></p><par n="Ø_duhat"/></e>
      <e><p><l>čieža</l><r>syv</r></p><par n="Ø_duhat"/></e>
      <e r="LR"><p><l>gieža</l><r>syv</r></p><par n="Ø_duhat"/></e>
      <e><p><l>gávcci</l><r>åtte</r></p><par n="Ø_duhat"/></e>
      <e><p><l>ovcci</l><r>ni</r></p><par n="Ø_duhat"/></e>
    </pardef>

    <!-- pardefs: NOUNS -->
    <pardef n="pl__n" c="same as above, but always generates nob pl">
      <e r="LR"><p><l><s n="sg"/></l><r><s n="pl"/><s n="CD"/></r></p></e>
      <e r="LR"><p><l><s n="sg"/><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e r="LR"><p><l><s n="sg"/><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e r="LR"><p><l><s n="sg"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e r="LR"><p><l><s n="sg"/><s n="ill"/></l><r><s n="pl"/><s n="ill"/></r></p></e>
      <e r="LR"><p><l><s n="sg"/><s n="loc"/></l><r><s n="pl"/><s n="loc"/></r></p></e>
      <e r="LR"><p><l><s n="sg"/><s n="com"/></l><r><s n="pl"/><s n="com"/></r></p></e>
      <e><p><l><s n="pl"/></l><r><s n="pl"/><s n="CD"/></r></p></e>
      <e><p><l><s n="pl"/><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/></l><r><s n="pl"/><s n="ill"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/></l><r><s n="pl"/><s n="loc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="com"/></l><r><s n="pl"/><s n="com"/></r></p></e>
      <!-- todo: find counter-examples -->
      <e><p><l><s n="ess"/></l><r><s n="pl"/><s n="ind"/><s n="ess"/></r></p></e>

      <!-- todo: is N.Attr a bug in the lexc? seems to only appear in compounds, eg. čuohtejagi -->
      <e><p><l><s n="attr"/></l><r><s n="pl"/><s n="gen"/></r></p></e>

      <e><p><l><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e><p><l><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e><p><l><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e><p><l><s n="ill"/></l><r><s n="pl"/><s n="ill"/></r></p></e>
      <e><p><l><s n="loc"/></l><r><s n="pl"/><s n="loc"/></r></p></e>
      <e><p><l><s n="com"/></l><r><s n="pl"/><s n="com"/></r></p></e>

      <!-- TODO transfer rule to introduce 'lille'? -->
      <!-- TODO: how does this combine with Cmp tags? (should probably factor out this) -->
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/></l><r><s n="pl"/><s n="CD"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="ill"/></l><r><s n="pl"/><s n="ill"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="loc"/></l><r><s n="pl"/><s n="loc"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="com"/></l><r><s n="pl"/><s n="com"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/></l><r><s n="pl"/><s n="CD"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="ill"/></l><r><s n="pl"/><s n="ill"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="loc"/></l><r><s n="pl"/><s n="loc"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="com"/></l><r><s n="pl"/><s n="com"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="ess"/></l><r><s n="pl"/><s n="ind"/><s n="ess"/></r></p></e>

      <e><p><l><s n="cmp_sgnom"/><s n="cmp"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e><p><l><s n="cmp_sggen"/><s n="cmp"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e><p><l><s n="cmp"/></l><r><s n="pl"/><s n="CD"/></r></p></e>
      <!-- e.g. "^eanan-/eanan<n><cmp_splitr>$" in "eanan- ja luonddudoahpagiid": -->
      <e><p><l><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="pl"/><s n="CD"/></r></p></e>
      <e><p><l><s n="cmp_sgnom"/><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e><p><l><s n="cmp_sggen"/><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
    </pardef>
    <pardef n="nocmp__n" c="same as above, bu neber cmp ">
      <e r="LR"><p><l><s n="sg"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <e><p><l><s n="pl"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <e><p><l><s n="ess"/></l><r><s n="sg"/><s n="ind"/><s n="CD"/></r></p></e>
    </pardef>
    <pardef n="sg__n" c="same as above, but always generates nob sg">
      <e r="LR"><p><l><s n="sg"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <e><p><l><s n="pl"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <e><p><l><s n="ess"/></l><r><s n="sg"/><s n="ind"/><s n="CD"/></r></p></e>

      <!-- todo: is N.Attr a bug in the lexc? seems to only appear in compounds, eg. čuohtejagi -->
      <e><p><l><s n="attr"/></l><r><s n="sg"/><s n="gen"/></r></p></e>


      <!-- TODO transfer rule to introduce 'lille'? -->
      <!-- TODO: how does this combine with Cmp tags? (should probably factor out this) -->
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="acc"/></l><r><s n="sg"/><s n="acc"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="nom"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="acc"/></l><r><s n="sg"/><s n="acc"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="gen"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="ill"/></l><r><s n="sg"/><s n="ill"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="loc"/></l><r><s n="sg"/><s n="loc"/></r></p></e>
      <e r="LR"><p><l><s n="der_dimin"/><s n="n"/><s n="sg"/><s n="com"/></l><r><s n="sg"/><s n="com"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="nom"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="acc"/></l><r><s n="sg"/><s n="acc"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="gen"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="ill"/></l><r><s n="sg"/><s n="ill"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="loc"/></l><r><s n="sg"/><s n="loc"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="pl"/><s n="com"/></l><r><s n="sg"/><s n="com"/></r></p></e>
      <e><p><l><s n="der_dimin"/><s n="n"/><s n="ess"/></l><r><s n="sg"/><s n="ind"/><s n="ess"/></r></p></e>

      <e><p><l><s n="cmp_sgnom"/><s n="cmp"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="cmp_sggen"/><s n="cmp"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
      <e><p><l><s n="cmp"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <!-- e.g. "^eanan-/eanan<n><cmp_splitr>$" in "eanan- ja luonddudoahpagiid": -->
      <e><p><l><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <e><p><l><s n="cmp_sgnom"/><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="cmp_sggen"/><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
    </pardef>

    <pardef n="sgpl__n">
      <e><p><l></l><r></r></p><par n="sg__n"/></e>
      <e><p><l></l><r></r></p><par n="pl__n"/></e>
    </pardef>

    <pardef n="cmp__n" c="Use when you want a bidix exception for Cmp-marked only (lhs's)">
      <e><p><l><s n="cmp_sgnom"/><s n="cmp"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="cmp_sggen"/><s n="cmp"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
      <e><p><l><s n="cmp"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <!-- e.g. "^eanan-/eanan<n><cmp_splitr>$" in "eanan- ja luonddudoahpagiid": -->
      <e><p><l><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="sg"/><s n="CD"/></r></p></e>
      <e><p><l><s n="cmp_sgnom"/><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="sg"/><s n="nom"/><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="cmp_sggen"/><s n="cmp_splitr"/><s n="cmp"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
    </pardef>

    <pardef n="maydetind__n" c="Tell transfer that this noun may take an indefinite determiner">
      <e r="LR"><p><l></l>                    <r><s n="maydetind"/></r></p></e>
      <e r="RL"><p><l></l>                    <r></r></p></e>
      <e r="RL"><p><l>EMPTY_LEFT_SIDE_HACK</l><r>EMPTY_LEFT_SIDE_HACK</r></p></e>
    </pardef>
    <pardef n="unc__n" c="Add unc tag iff going from sme to nob (currently just used for ensuring indefiniteness in transfer).">
      <e r="LR"><p><l></l>                    <r><s n="unc"/></r></p></e>
      <e r="RL"><p><l></l>                    <r></r></p></e>
      <e r="RL"><p><l>EMPTY_LEFT_SIDE_HACK</l><r>EMPTY_LEFT_SIDE_HACK</r></p></e>
    </pardef>
    <pardef n="unc_sp__n" c="Add unc tag iff going from sme to nob (currently just used for ensuring indefiniteness in transfer).">
      <e r="LR"><p><l></l>                    <r><s n="unc"/></r></p></e>
      <e r="RL"><p><l></l>                    <r></r></p></e>
      <e r="RL"><p><l>EMPTY_LEFT_SIDE_HACK</l><r>EMPTY_LEFT_SIDE_HACK</r></p></e>
    </pardef>
    <pardef n="unc_m_RL_f__n" c="Generate nob masc, but analyse fem (eventually, when we move on to nob->sme).
                                 Add unc tag iff going from sme to nob (for ensuring indefiniteness in transfer).">
      <e><p><l></l><r><s n="m"/></r></p><par n="unc__n"/></e>
      <e r="RL"><p><l></l><r><s n="f"/></r></p><par n="unc__n"/></e>
    </pardef>
    <pardef n="unc_f_RL_m__n" c="Generate nob fem, but analyse masc (eventually, when we move on to nob->sme).
                                 Add unc tag iff going from sme to nob (for ensuring indefiniteness in transfer).">
      <e><p><l></l><r><s n="f"/></r></p><par n="unc__n"/></e>
      <e r="RL"><p><l></l><r><s n="m"/></r></p><par n="unc__n"/></e>
    </pardef>
    <pardef n="m_RL_f__n" c="Generate nob masc, but analyse fem (eventually, when we move on to nob->sme). (swapped, TT)
                             Swap back if you want more conservative bokmål (we could do variants?).
                             The f_RL_m__n pardef is used for words that should be fem even in conservative bokmål.">
      <e><p><l></l><r><s n="f"/></r></p></e>
      <e r="RL"><p><l></l><r><s n="m"/></r></p></e>
    </pardef>
    <pardef n="sg_m_RL_f__n" c="Generate nob masc *sg*, but analyse fem (eventually, when we move on to nob->sme).">
      <e><p><l></l><r><s n="m"/></r></p><par n="sg__n"/></e>
      <e r="RL"><p><l></l><r><s n="f"/></r></p><par n="sg__n"/></e>
    </pardef>
    <pardef n="f_RL_m__n" c="Generate nob fem, but analyse masc (eventually, when we move on to nob->sme).
                             TODO: at the moment, anything that gets an 'f' when generating bokmål is assumed to
                             be 'f' for purposes of pro-drop insertion in transfer, and gets this pardef.
                             Not ideal (sem-gen != morph-gen)">
      <e><p><l></l><r><s n="f"/></r></p></e>
      <e r="RL"><p><l></l><r><s n="m"/></r></p></e>
    </pardef>
    <pardef n="coll__n" c="Treat as uncountable when generating nob (since they're already counted), only generate plural">
      <e r="LR"><p><l><s n="n"/><s n="coll"/><s n="sem_group_hum"/></l>  <r><s n="n"/><s n="un"/><s n="unc"/></r></p><par n="pl__n"/></e>
      <e r="RL"><p><l><s n="n"/><s n="coll"/><s n="sem_group_hum"/></l>  <r><s n="n"/><s n="un"/></r></p></e>
      <e r="LR"><p><l><s n="n"/><s n="coll"/></l>  <r><s n="n"/><s n="un"/><s n="unc"/></r></p><par n="pl__n"/></e>
      <e r="RL"><p><l><s n="n"/><s n="coll"/></l>  <r><s n="n"/><s n="un"/></r></p></e>
    </pardef>
    <pardef n="__np" c="The nob tags are not output by transfer.">
      <e><p><l><s n="sg"/><s n="attr"/></l><r><s n="sg"/></r></p></e>
      <e><p><l><s n="sg"/><s n="nom"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="sg"/><s n="acc"/></l><r><s n="sg"/><s n="acc"/></r></p></e>
      <e><p><l><s n="sg"/><s n="gen"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="ill"/></l><r><s n="sg"/><s n="ill"/></r></p></e>
      <e><p><l><s n="sg"/><s n="loc"/></l><r><s n="sg"/><s n="loc"/></r></p></e>
      <e><p><l><s n="sg"/><s n="com"/></l><r><s n="sg"/><s n="com"/></r></p></e>

      <e><p><l><s n="ess"/></l><r><s n="sg"/><s n="ess"/></r></p></e>

      <e><p><l><s n="attr"/></l><r></r></p></e>

      <e><p><l><s n="pl"/><s n="attr"/></l><r><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/></l><r><s n="pl"/><s n="acc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/></l><r><s n="pl"/><s n="ill"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/></l><r><s n="pl"/><s n="loc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="com"/></l><r><s n="pl"/><s n="com"/></r></p></e>

      <e><p><l></l><r></r></p></e>
      <!-- The same again with Gen→gen: -->
      <e><p><l><s n="sg"/><s n="attr"/><s n="gen"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="nom"/><s n="gen"/></l><r><s n="sg"/><s n="nom"/><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="acc"/><s n="gen"/></l><r><s n="sg"/><s n="acc"/><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="gen"/><s n="gen"/></l><r><s n="sg"/><s n="gen"/><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="ill"/><s n="gen"/></l><r><s n="sg"/><s n="ill"/><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="loc"/><s n="gen"/></l><r><s n="sg"/><s n="loc"/><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="com"/><s n="gen"/></l><r><s n="sg"/><s n="com"/><s n="gen"/></r></p></e>

      <e><p><l><s n="ess"/><s n="gen"/></l><r><s n="sg"/><s n="ess"/><s n="gen"/></r></p></e>

      <e><p><l><s n="pl"/><s n="attr"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="nom"/><s n="gen"/></l><r><s n="pl"/><s n="nom"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/><s n="gen"/></l><r><s n="pl"/><s n="acc"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/><s n="gen"/></l><r><s n="pl"/><s n="gen"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/><s n="gen"/></l><r><s n="pl"/><s n="ill"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/><s n="gen"/></l><r><s n="pl"/><s n="loc"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="com"/><s n="gen"/></l><r><s n="pl"/><s n="com"/><s n="gen"/></r></p></e>

      <e><p><l><s n="gen"/></l><r><s n="gen"/></r></p></e>
    </pardef>

    <pardef n="abbr__n" c="Add unc tag since we don't want abbreviations to go definite">
      <e>              <p><l><s n="n"/><s n="abbr"/></l><r><s n="n"/><s n="acr"/></r></p><par n="unc__n"/></e>
    </pardef>

    <pardef n="adj__n" c=" ">
      <e><p><l><s n="sg"/><s n="nom"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="sg"/><s n="acc"/></l><r><s n="sg"/><s n="acc"/></r></p></e>
      <e><p><l><s n="sg"/><s n="gen"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
      <e><p><l><s n="sg"/><s n="com"/></l><r><s n="sg"/><s n="com"/></r></p></e>
      <e><p><l><s n="sg"/><s n="ill"/></l><r><s n="sg"/><s n="ill"/></r></p></e>
      <e><p><l><s n="sg"/><s n="loc"/></l><r><s n="sg"/><s n="loc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="nom"/></l><r><s n="sg"/><s n="nom"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/></l><r><s n="sg"/><s n="acc"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/></l><r><s n="sg"/><s n="gen"/></r></p></e>
      <e><p><l><s n="pl"/><s n="com"/></l><r><s n="sg"/><s n="com"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/></l><r><s n="sg"/><s n="ill"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/></l><r><s n="sg"/><s n="loc"/></r></p></e>
      <e><p><l><s n="ess"/></l><r><s n="ess"/></r></p></e>
      <e><p><l><s n="cmp_attr"/><s n="cmp"/></l>      <r><s n="pst"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p></e>
      <e><p><l><s n="cmp_sgnom"/><s n="cmp"/></l>     <r><s n="pst"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p></e>
    </pardef>




    <pardef n="alphabet__n" c="Add unc tag since we don't want abbreviations to go definite">
      <e>         <p><l><s n="n"/><s n="abbr"/></l> <r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/></r></p><par n="unc__n"/></e>
      <e r="LR">  <p><l><s n="abbr"/></l>           <r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/></r></p><par n="unc__n"/></e>
    </pardef>

    <!-- pardefs: ADJECTIVES -->
    <pardef n="n__adj" c="Used for sme nouns translated into nob adj's
                          No tags on l, since we want to allow ambiguity with plain n-to-n entries">
      <e><p><l></l>          <r><s n="pst"/></r></p></e>
    </pardef>


    <pardef n="nder__adj">
      <e><p><l><s n="der_comp"/><s n="adj"/><s n="sg"/><s n="nom"/></l><r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/><s n="pl"/><s n="nom"/></l><r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/><s n="attr"/></l><r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/><s n="sg"/></l>        <r><s n="sup"/><s n="un"/><s n="sp"/><s n="ind"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/><s n="pl"/></l>        <r><s n="sup"/><s n="un"/><s n="sp"/><s n="def"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/><s n="attr"/></l>      <r><s n="sup"/><s n="un"/><s n="sp"/><s n="def"/></r></p></e>
    </pardef>


    <pardef n="nocmp__adj">
      <!-- TODO: adj.ord, adj.pp, adj.pprs (all of which need GD and ND) -->
      <e><p><l><s n="attr"/></l>          <r><s n="pst"/><s n="GD"/><s n="ND"/></r></p></e>
      <e><p><l><s n="sg"/><s n="nom"/></l><r><s n="pst"/><s n="GD"/><s n="sg"/></r></p></e>
      <e><p><l><s n="sg"/><s n="acc"/></l><r><s n="pst"/><s n="GD"/><s n="sg"/></r></p></e>
      <e><p><l><s n="sg"/><s n="gen"/></l><r><s n="pst"/><s n="GD"/><s n="sg"/></r></p></e>
      <e><p><l><s n="sg"/><s n="loc"/></l><r><s n="pst"/><s n="GD"/><s n="sg"/></r></p></e>
      <e><p><l><s n="sg"/><s n="ill"/></l><r><s n="pst"/><s n="GD"/><s n="sg"/></r></p></e>
      <e><p><l><s n="pl"/><s n="nom"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/><s n="sg"/><s n="nom"/></l><r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/><s n="pl"/><s n="nom"/></l><r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/></l>          <r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/><s n="attr"/></l><r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/></l>        <r><s n="sup"/><s n="un"/><s n="sp"/><s n="ind"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/><s n="sg"/></l>        <r><s n="sup"/><s n="un"/><s n="sp"/><s n="ind"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/><s n="pl"/></l>        <r><s n="sup"/><s n="un"/><s n="sp"/><s n="def"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/><s n="attr"/></l>      <r><s n="sup"/><s n="un"/><s n="sp"/><s n="def"/></r></p></e>

      <!-- Should we do anything else for A.Ess ? -->
      <e><p><l><s n="ess"/></l>          <r><s n="pst"/><s n="GD"/><s n="ND"/></r></p></e>

      <!-- Don't add an 'n' or 'adv' tag to the r's here;
	   we don't introduce PoS changes in pardefs!
	   The derived nob noun might not exist. -->
      <e r="LR"><p><l><s n="der_vuota"/><s n="n"/></l> <r><s n="pst"/><s n="GD"/><s n="def"/></r></p></e>
      <!-- Most adverbial uses of adjectives are posi.nt.sg.ind -->
      <e r="LR"><p><l><s n="der_aadv"/><s n="adv"/></l> <r><s n="adj"/><s n="pst"/><s n="nt"/><s n="sg"/><s n="ind"/></r></p></e>
      <!-- TODO: Focus [Foc_ge] etc.  -->
      <!-- "Leago dát duođasge Sáme Radio oaivil ?" -->
    </pardef>
    <pardef n="__adj">
      <e><p><l></l>          <r></r></p><par n="nocmp__adj"/></e>

      <e><p><l><s n="cmp_attr"/><s n="cmp"/></l>      <r><s n="pst"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p></e>
      <e><p><l><s n="cmp_sgnom"/><s n="cmp"/></l>     <r><s n="pst"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p></e>
    </pardef>
    <pardef n="pl__adj" c="as above, but always goes to nob plural (some nob adj's only have plural forms)">
      <!-- TODO: adj.ord, adj.pp, adj.pprs (all of which need GD and ND) -->
      <e><p><l><s n="attr"/></l>          <r><s n="pst"/><s n="GD"/><s n="ND"/></r></p></e>
      <e><p><l><s n="sg"/><s n="nom"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="sg"/><s n="acc"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="sg"/><s n="gen"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="sg"/><s n="loc"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="sg"/><s n="ill"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="nom"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="acc"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="gen"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="loc"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="pl"/><s n="ill"/></l><r><s n="pst"/><s n="GD"/><s n="pl"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/><s n="sg"/><s n="nom"/></l><r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/><s n="pl"/><s n="nom"/></l><r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/></l>          <r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_comp"/><s n="adj"/><s n="attr"/></l><r><s n="comp"/><s n="un"/><s n="sp"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/></l>        <r><s n="sup"/><s n="un"/><s n="sp"/><s n="ind"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/><s n="sg"/></l>        <r><s n="sup"/><s n="un"/><s n="sp"/><s n="ind"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/><s n="pl"/></l>        <r><s n="sup"/><s n="un"/><s n="sp"/><s n="def"/></r></p></e>
      <e><p><l><s n="der_superl"/><s n="adj"/><s n="attr"/></l>      <r><s n="sup"/><s n="un"/><s n="sp"/><s n="def"/></r></p></e>

      <!-- TODO: testing adj.cmp -->
      <e><p><l><s n="cmp_attr"/><s n="cmp"/></l>      <r><s n="pst"/><s n="un"/><s n="pl"/><s n="ind"/></r></p></e>
      <e><p><l><s n="cmp_sgnom"/><s n="cmp"/></l>     <r><s n="pst"/><s n="un"/><s n="pl"/><s n="ind"/></r></p></e>

      <!-- Should we do anything else for A.Ess ? -->
      <e><p><l><s n="ess"/></l>          <r><s n="pst"/><s n="GD"/><s n="ND"/></r></p></e>

      <!-- Don't add an 'n' or 'adv' tag to the <r>'s here;
	   we don't introduce PoS changes in pardefs!
	   The derived nob noun might not exist. -->
      <e r="LR"><p><l><s n="der_vuota"/><s n="n"/></l> <r><s n="pst"/><s n="GD"/><s n="def"/></r></p></e>
      <!-- Most adverbial uses of adjectives are posi.nt.sg.ind -->
      <e r="LR"><p><l><s n="der_aadv"/><s n="adv"/></l> <r><s n="adj"/><s n="pst"/><s n="nt"/><s n="sg"/><s n="ind"/></r></p></e>
      <!-- TODO: Focus [Foc_ge] etc.  -->
      <!-- "Leago dát duođasge Sáme Radio oaivil ?" -->
    </pardef>
    <pardef n="cmp:pl__adj" c="">
      <e><p><l></l>          <r></r></p><par n="nocmp__adj"/></e>

      <e><p><l><s n="cmp_attr"/><s n="cmp"/></l>      <r><s n="pst"/><s n="mf"/><s n="pl"/><s n="ind"/></r></p></e>
      <e><p><l><s n="cmp_sgnom"/><s n="cmp"/></l>     <r><s n="pst"/><s n="mf"/><s n="pl"/><s n="ind"/></r></p></e>
    </pardef>
    <pardef n="cmp__adj" c="Adjectives which are only to be used as compound parts.">
      <e><p><l><s n="cmp_attr"/><s n="cmp"/></l>      <r><s n="pst"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p></e>
      <e><p><l><s n="cmp_attr"/><s n="cmp_hyph"/><s n="cmp"/></l><r><s n="pst"/><s n="mf"/><s n="sg"/><s n="ind"/><s n="guio"/></r></p></e>
      <e><p><l><s n="cmp_sgnom"/><s n="cmp"/></l>     <r><s n="pst"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p></e>
    </pardef>
    <pardef n="ord__adj">
      <e><p><l><s n="adj"/><s n="arab"/><s n="ord"/></l> <r><s n="adj"/><s n="ord"/></r></p><par n="__adj"/></e>
      <e><p><l><s n="adj"/><s n="ord"/></l> <r><s n="adj"/><s n="ord"/></r></p><par n="__adj"/></e>
       <e><p><l><s n="adj"/><s n="ord"/><s n="cmp_sgnom"/><s n="cmp_hyph"/><s n="cmp"/></l><r><s n="adj"/><s n="ord"/></r></p></e>
    </pardef>

    <!-- pardefs: VERBS -->
    <pardef n="__nbr_pers">
      <e><p><l><s n="p1"/><s n="sg"/></l><r><s n="p1"/><s n="sg"/></r></p></e>
      <e><p><l><s n="p2"/><s n="sg"/></l><r><s n="p2"/><s n="sg"/></r></p></e>
      <e><p><l><s n="p3"/><s n="sg"/></l><r><s n="p3"/><s n="sg"/></r></p></e>
      <e><p><l><s n="p1"/><s n="du"/></l><r><s n="p1"/><s n="du"/></r></p></e>
      <e><p><l><s n="p2"/><s n="du"/></l><r><s n="p2"/><s n="du"/></r></p></e>
      <e><p><l><s n="p3"/><s n="du"/></l><r><s n="p3"/><s n="du"/></r></p></e>
      <e><p><l><s n="p1"/><s n="pl"/></l><r><s n="p1"/><s n="pl"/></r></p></e>
      <e><p><l><s n="p2"/><s n="pl"/></l><r><s n="p2"/><s n="pl"/></r></p></e>
      <e><p><l><s n="p3"/><s n="pl"/></l><r><s n="p3"/><s n="pl"/></r></p></e>
      <e><p><l><s n="px1sg"/></l><r><s n="p1"/><s n="sg"/></r></p></e>
      <e><p><l><s n="px2sg"/></l><r><s n="p2"/><s n="sg"/></r></p></e>
      <e><p><l><s n="px3sg"/></l><r><s n="p3"/><s n="sg"/></r></p></e>
      <e><p><l><s n="px1du"/></l><r><s n="p1"/><s n="du"/></r></p></e>
      <e><p><l><s n="px2du"/></l><r><s n="p2"/><s n="du"/></r></p></e>
      <e><p><l><s n="px3du"/></l><r><s n="p3"/><s n="du"/></r></p></e>
      <e><p><l><s n="px1pl"/></l><r><s n="p1"/><s n="pl"/></r></p></e>
      <e><p><l><s n="px2pl"/></l><r><s n="p2"/><s n="pl"/></r></p></e>
      <e><p><l><s n="px3pl"/></l><r><s n="p3"/><s n="pl"/></r></p></e>
      <!-- default when no person: p3 -->
      <e><p><l><s n="sg"/></l><r><s n="p3"/><s n="sg"/></r></p></e>
      <e><p><l><s n="du"/></l><r><s n="p3"/><s n="du"/></r></p></e>
      <e><p><l><s n="pl"/></l><r><s n="p3"/><s n="pl"/></r></p></e>
    </pardef>
    <pardef n="LR_remove_nbr_pers">
      <e r="LR"><p><l><s n="p1"/><s n="sg"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="p2"/><s n="sg"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="p3"/><s n="sg"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="p1"/><s n="du"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="p2"/><s n="du"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="p3"/><s n="du"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="p1"/><s n="pl"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="p2"/><s n="pl"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="p3"/><s n="pl"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="px1sg"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="px2sg"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="px3sg"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="px1du"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="px2du"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="px3du"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="px1pl"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="px2pl"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="px3pl"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="sg"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="du"/></l><r></r></p></e>
      <e r="LR"><p><l><s n="pl"/></l><r></r></p></e>
    </pardef>

    <pardef n="modal_common__verb" c="Used by common__verb">
      <e><p><l><s n="cond"/></l><r><s n="cond"/></r></p></e>
      <e><p><l><s n="cond"/></l><r><s n="cond-ville"/></r></p></e>
      <e><p><l><s n="cond"/></l><r><s n="cond-kunne"/></r></p></e>
      <e><p><l></l><r></r></p></e>
    </pardef>

    <pardef n="pass__temps_nbr_pers" c="Used by passive derivations in common__verb, adds pasv tag (note that pp gets periphrastic 'blitt' in t1x)">
      <e><p><l><s n="vblex"/><s n="iv"/><s n="inf"/></l><r><s n="inf"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="indic"/><s n="pres"/></l><r><s n="pres"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="indic"/><s n="pret"/></l><r><s n="pret"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="cond"/><s n="pres"/></l><r><s n="pres"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="cond"/><s n="pret"/></l><r><s n="pret"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="prfprc"/></l><r><s n="pp"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="prsprc"/></l><r><s n="pres"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="imp"/></l><r><s n="inf"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/></l><r><s n="pasv"/></r></p><par n="modal_common__verb"/></e>

      <!-- no transitivity tag for der_halla: -->
      <e><p><l><s n="vblex"/><s n="inf"/></l><r><s n="inf"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="indic"/><s n="pres"/></l><r><s n="pres"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="indic"/><s n="pret"/></l><r><s n="pret"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="cond"/><s n="pres"/></l><r><s n="pres"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="cond"/><s n="pret"/></l><r><s n="pret"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="prfprc"/></l><r><s n="pp"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="prsprc"/></l><r><s n="pres"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="imp"/></l><r><s n="inf"/><s n="pasv"/></r></p></e>
      <e><p><l><s n="vblex"/></l><r><s n="pasv"/></r></p><par n="modal_common__verb"/></e>
    </pardef>

    <pardef n="caus__temps_nbr_pers" c="Used by causative derivations in common__verb, adds caus tag to all temps">
      <e><p><l><s n="vblex"/><s n="tv"/><s n="inf"/></l><r><s n="caus"/><s n="inf"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="tv"/><s n="indic"/><s n="pres"/></l><r><s n="caus"/><s n="pres"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="tv"/><s n="indic"/><s n="pret"/></l><r><s n="caus"/><s n="pret"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="tv"/><s n="cond"/><s n="pres"/></l><r><s n="caus"/><s n="pres"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="tv"/><s n="cond"/><s n="pret"/></l><r><s n="caus"/><s n="pret"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="tv"/><s n="prfprc"/></l><r><s n="caus"/><s n="pp"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="tv"/><s n="prsprc"/></l><r><s n="caus"/><s n="pres"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="tv"/><s n="imp"/></l><r><s n="caus"/><s n="imp"/><s n="sg"/><s n="p2"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="tv"/></l><r><s n="caus"/></r></p><par n="modal_common__verb"/></e>

      <e><p><l><s n="vblex"/><s n="iv"/><s n="inf"/></l><r><s n="caus"/><s n="inf"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="indic"/><s n="pres"/></l><r><s n="caus"/><s n="pres"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="indic"/><s n="pret"/></l><r><s n="caus"/><s n="pret"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="cond"/><s n="pres"/></l><r><s n="caus"/><s n="pres"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="cond"/><s n="pret"/></l><r><s n="caus"/><s n="pret"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="prfprc"/></l><r><s n="caus"/><s n="pp"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="prsprc"/></l><r><s n="caus"/><s n="pres"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/><s n="imp"/></l><r><s n="caus"/><s n="imp"/><s n="sg"/><s n="p2"/></r></p></e>
      <e><p><l><s n="vblex"/><s n="iv"/></l><r><s n="caus"/></r></p><par n="modal_common__verb"/></e>
    </pardef>

    <pardef n="common__verb" c="Used by __verb and pstv__verb">
      <e><p><l><s n="indic"/><s n="pres"/></l> <r><s n="pres"/></r></p></e>
      <e><p><l><s n="indic"/><s n="pret"/></l> <r><s n="pret"/></r></p></e>
      <e><p><l><s n="inf"/></l>               <r><s n="inf"/></r></p></e>
      <e><p><l><s n="prfprc"/></l>            <r><s n="pp"/></r></p></e>

      <e><p><l></l>                           <r></r></p><par n="modal_common__verb"/></e>

      <!-- TODO: Currently the supine is just ignored. (Also, if we put it in a clip in transfer, it might interfere with the nob superlative tag...) -->
      <e><p><l><s n="supn"/></l>              <r></r></p></e>

      <!-- Passive derivation: -->
      <e><p><l><s n="der_passl"/></l> <r></r></p><par n="pass__temps_nbr_pers"/></e>
      <e><p><l><s n="der_passs"/></l> <r></r></p><par n="pass__temps_nbr_pers"/></e>
      <e><p><l><s n="der_halla"/></l> <r></r></p><par n="pass__temps_nbr_pers"/></e>

      <!-- Causative: -->
      <e><p><l><s n="der_h"/></l>     <r></r></p><par n="caus__temps_nbr_pers"/></e>
      <e><p><l><s n="der_ahtti"/></l> <r></r></p><par n="caus__temps_nbr_pers"/></e>
      <e><p><l><s n="der_caus"/></l> <r></r></p><par n="caus__temps_nbr_pers"/></e>

      <!-- other derivations: -->
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="inf"/></l>                   <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="indic"/><s n="pres"/></l>    <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="indic"/><s n="pret"/></l>    <r><s n="pret"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="cond"/><s n="pres"/></l>     <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="cond"/><s n="pret"/></l>     <r><s n="pret"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="prfprc"/></l>                <r><s n="pp"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="prsprc"/></l>                <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="imp"/></l>                   <r><s n="inf"/><s n="sg"/><s n="p2"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="actio"/><s n="nom"/></l>     <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="actio"/><s n="gen"/></l>     <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="actio"/><s n="ess"/></l>     <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="actio"/><s n="loc"/></l>     <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="actio"/><s n="acc"/></l>     <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="ger"/></l>                   <r><s n="TD"/><s n="ND"/><s n="PD"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/></l>                               <r></r></p><par n="modal_common__verb"/></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="inf"/></l>                <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="indic"/><s n="pres"/></l> <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="indic"/><s n="pret"/></l> <r><s n="pret"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="cond"/><s n="pres"/></l>  <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="cond"/><s n="pret"/></l>  <r><s n="pret"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="prfprc"/></l>             <r><s n="pp"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="prsprc"/></l>             <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="imp"/></l>                <r><s n="inf"/><s n="sg"/><s n="p2"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="actio"/><s n="nom"/></l>  <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="actio"/><s n="gen"/></l>  <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="actio"/><s n="ess"/></l>  <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="actio"/><s n="loc"/></l>  <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="actio"/><s n="acc"/></l>  <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/><s n="ger"/></l>                <r><s n="TD"/><s n="ND"/><s n="PD"/></r></p></e>
      <e><p><l><s n="der_alla"/><s n="vblex"/></l>                            <r></r></p><par n="modal_common__verb"/></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="inf"/></l>                <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="indic"/><s n="pres"/></l> <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="indic"/><s n="pret"/></l> <r><s n="pret"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="cond"/><s n="pres"/></l>  <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="cond"/><s n="pret"/></l>  <r><s n="pret"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="prfprc"/></l>             <r><s n="pp"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="prsprc"/></l>             <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="imp"/></l>                <r><s n="inf"/><s n="sg"/><s n="p2"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="actio"/><s n="nom"/></l>  <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="actio"/><s n="gen"/></l>  <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="actio"/><s n="ess"/></l>  <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="actio"/><s n="loc"/></l>  <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="actio"/><s n="acc"/></l>  <r><s n="TD"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/><s n="ger"/></l>                <r><s n="TD"/><s n="ND"/><s n="PD"/></r></p></e>
      <e><p><l><s n="der_adda"/><s n="vblex"/></l>                            <r></r></p><par n="modal_common__verb"/></e>

      <!-- TODO: add "litt"? or just let it slide, and add word-specific exceptions? -->
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="inf"/></l>                <r><s n="der_st"/><s n="inf"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="indic"/><s n="pres"/></l> <r><s n="der_st"/><s n="pres"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="indic"/><s n="pret"/></l> <r><s n="der_st"/><s n="pret"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="cond"/><s n="pres"/></l>  <r><s n="der_st"/><s n="pres"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="cond"/><s n="pret"/></l>  <r><s n="der_st"/><s n="pret"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="prfprc"/></l>             <r><s n="der_st"/><s n="pp"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="prsprc"/></l>             <r><s n="der_st"/><s n="pres"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="imp"/></l>                <r><s n="der_st"/><s n="inf"/><s n="sg"/><s n="p2"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/></l>                            <r></r></p><par n="modal_common__verb"/></e>


      <e><p><l><s n="der_l"/><s n="vblex"/><s n="inf"/></l>                          <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_l"/><s n="vblex"/><s n="indic"/><s n="pres"/></l>           <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_l"/><s n="vblex"/><s n="indic"/><s n="pret"/></l>           <r><s n="pret"/></r></p></e>
      <e><p><l><s n="der_l"/><s n="vblex"/><s n="cond"/><s n="pres"/></l>            <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_l"/><s n="vblex"/><s n="cond"/><s n="pret"/></l>            <r><s n="pret"/></r></p></e>
      <e><p><l><s n="der_l"/><s n="vblex"/><s n="prfprc"/></l>                       <r><s n="pp"/></r></p></e>
      <e><p><l><s n="der_l"/><s n="vblex"/><s n="prsprc"/></l>                       <r><s n="pres"/></r></p></e>
      <e><p><l><s n="der_l"/><s n="vblex"/><s n="imp"/></l>                          <r><s n="inf"/><s n="sg"/><s n="p2"/></r></p></e>
      <e><p><l><s n="der_l"/><s n="vblex"/></l>                                      <r></r></p><par n="modal_common__verb"/></e>

      <e><p><l><s n="der_nomag"/><s n="n"/></l>  <r><j/>er<s n="n"/><s n="m"/></r></p></e>
      <e><p><l><s n="der_nomact"/><s n="n"/></l> <r><j/>ing<s n="n"/><s n="m"/></r></p></e>
      <!-- der_muš is stuff like uttale=>uttalelse, ville=>vilje -->
      <e><p><l><s n="der_muš"/><s n="n"/></l>    <r><j/>ing<s n="n"/><s n="m"/></r></p></e>

      <!-- Used in agent construction: du čállin reivve => brevet som du har/hadde skrevet -->
      <e><p><l><s n="actio"/><s n="nom"/></l> <r><s n="TD"/></r></p></e>
      <e><p><l><s n="actio"/><s n="gen"/></l> <r><s n="TD"/></r></p></e>
      <!-- Here we prepend 'i gang med å' in t1x: -->
      <e><p><l><s n="actio"/><s n="ess"/></l> <r><s n="TD"/></r></p></e>
      <!-- Actio.Loc: same time or future compared to main verb -->
      <e><p><l><s n="actio"/><s n="loc"/></l> <r><s n="inf"/></r></p></e>
      <!-- Actio.Acc TODO -->
      <e><p><l><s n="actio"/><s n="acc"/></l> <r><s n="TD"/></r></p></e>
      <!-- Gerundium: same time and logical subject as main verb -->
<!--      <e><p><l><s n="ger"/></l>               <r><s n="TD"/><s n="ND"/><s n="PD"/></r></p></e> -->

      <!-- Verbal Abessive: an action that is not performed (insert 'uten') -->
      <e><p><l><s n="vabess"/></l>                                                        <r><s n="inf"/></r></p></e>
      <e><p><l><s n="vabess"/><s n="adj"/><s n="attr"/></l>                                 <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="vabess"/></l>                           <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_st"/><s n="vblex"/><s n="vabess"/><s n="adj"/><s n="attr"/></l>    <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="vabess"/></l>                            <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_d"/><s n="vblex"/><s n="vabess"/><s n="adj"/><s n="attr"/></l>     <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_passl"/><s n="vblex"/><s n="vabess"/></l>                        <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_passl"/><s n="vblex"/><s n="vabess"/><s n="adj"/><s n="attr"/></l> <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_passs"/><s n="vblex"/><s n="vabess"/></l>                        <r><s n="inf"/></r></p></e>
      <e><p><l><s n="der_passs"/><s n="vblex"/><s n="vabess"/><s n="adj"/><s n="attr"/></l> <r><s n="inf"/></r></p></e>
    </pardef>

    <pardef n="__verb" c="Regular verb, nob side should include adj.pp and adj.pprs forms">
      <e><p><l></l><r></r></p><par n="common__verb"/></e>

      <!-- Inchoative derivation -->
      <e><p><l><s n="der_inchl"/><s n="vblex"/></l><r></r></p><par n="common__verb"/></e>

      <e><p><l><s n="adj"/><s n="attr"/></l><r><s n="adj"/><s n="pprs"/></r></p></e>
      <!-- Definitely not sure about this: -->
      <e><p><l><s n="der_las"/><s n="adj"/></l><r><s n="adj"/><s n="pprs"/></r></p></e>
      <!-- Present participle: attribute in relative sentences (suomagiela hálli => som snakker finsk / finsksnakkende) -->
      <e><p><l><s n="prsprc"/></l><r><s n="adj"/><s n="pprs"/></r></p></e>
      <!-- (note: derivations have PrsPrc entries in common__verb, and use present tense instead for the adj pprs forms) -->
      <!-- Verb genitive: manner -->
      <e><p><l><s n="vgen"/></l><r><s n="adj"/><s n="pprs"/></r></p></e>
    </pardef>

    <pardef n="pstv__verb" c="Verb which in nob is lexicalised passive
			      nob side does not include imp or adj.pp and adj.pprs forms
			      Note: 'pass' forms are not in nob.dix either, but if we have passive + pstv, t1x just appends 'bli' as aux.">
      <e><p><l></l><r><s n="pstv"/></r></p><par n="common__verb"/></e>
      <!-- There are no adj forms for these on the nob side. Use present tense just to have something (if you want a real translation: lexicalise!) -->
      <e><p><l><s n="adj"/><s n="attr"/></l><r><s n="pstv"/><s n="pres"/></r></p></e>
      <e><p><l><s n="der_las"/><s n="adj"/></l><r><s n="pstv"/><s n="pres"/></r></p></e>
      <e><p><l><s n="prsprc"/></l><r><s n="pstv"/><s n="pres"/></r></p></e>
      <e><p><l><s n="vgen"/></l><r><s n="pstv"/><s n="pres"/></r></p></e>
    </pardef>

    <pardef n="caus__verb" c="TODO: might want to force causative transfer rules on some verbs,
			      use this rule then (o/w der_h in __verb adds the 'caus' tag)">
      <e><p><l></l><r><s n="caus"/></r></p><par n="__verb"/></e>
    </pardef>
    <pardef n="refl__verb">
      <e><p><l></l><r><s n="ref"/></r></p><par n="__verb"/></e>
    </pardef>
    <pardef n="pass__verb">
      <e><p><l></l><r><s n="pasv"/></r></p><par n="__verb"/></e>
    </pardef>
    <pardef n="lemq-obj__verb" c="Use on MWE verbs where the lemq can move past objects (default is just past adverbs)
				  (Transfer rules for this still todo)">
      <e><p><l></l><r><s n="lemq-obj"/></r></p><par n="__verb"/></e>
    </pardef>

  </pardefs>

  <section id="main" type="standard">
 <!-- Compound parts -->
<e r="LR"><p><l>mielde<s n="cmp_sh"/><s n="cmp"/></l><r>med<s n="adv"/></r></p></e>
